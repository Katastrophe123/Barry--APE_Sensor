# ---------------------------------------------------------------------------
# Copy to .env and adjust. NEVER commit a real .env.
# ---------------------------------------------------------------------------

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database -------------------------------------------------------------
# Inside docker compose the host is the service name "db".
DATABASE_URL=postgresql+asyncpg://aps:aps@localhost:5432/aps
DB_ECHO=false

# --- Auth -----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120
AUTH_USERNAME=operator
AUTH_PASSWORD=change-me

# --- Model artifacts ------------------------------------------------------
ARTIFACTS_DIR=artifacts
TRAINING_DATA_PATH=data/sample/aps_sample_train.csv

# --- Batch scoring --------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
MAX_BATCH_ROWS=200000
BATCH_CHUNK_SIZE=5000

# --- Drift detection ------------------------------------------------------
# PSI thresholds: >= significant marks a feature, >= critical flags the batch.
DRIFT_PSI_SIGNIFICANT=0.25
DRIFT_PSI_CRITICAL=1.0
# Share of drifted features that flags a batch on its own.
DRIFT_SHARE_THRESHOLD=0.1
DRIFT_MIN_ROWS=30
DRIFT_SAMPLE_SIZE=1000

# --- Scheduler ------------------------------------------------------------
# Off by default; the compose "worker" service turns it on.
SCHEDULER_ENABLED=false
SCHEDULED_SCORING_CRON=0 2 * * *
SCHEDULED_DRIFT_CRON=30 2 * * *
SCHEDULED_INPUT_DIR=data/incoming
SCHEDULED_OUTPUT_DIR=data/scored

# --- LLM (optional: maintenance notes only) -------------------------------
# stub -> deterministic offline client, no network and no API key needed
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_ATTEMPTS=2
LLM_BACKOFF_BASE_SECONDS=0.5
